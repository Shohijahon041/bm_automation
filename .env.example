# BM (dtransport.uz) avtomatizatsiya sozlamalari
# BM_ENV: test | prod
BM_ENV=test

# Test muhiti kredensiallari
BM_USERNAME=your_login
BM_PASSWORD=your_password

# Telegram ogohlantirish (monitoring uchun)
TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_DRIVER_CHAT_ID=          # eski: haydovchilar chat ID (ADMIN rolida)

# Transport Operations Bot — role-based access (chat_id vergul bilan)
# TG_ADMIN_IDS=123456789,987654321
# TG_DISPATCHER_IDS=555111222
# TG_DEFAULT_ROLE=viewer      # ro'yxatga kirmaganlar uchun: admin|dispatcher|viewer
# Eslatma: hech qanday rol berilmasa hamma ADMIN deb hisoblanadi (eski rejim).

# Ma'lumotlar bazasi (ixtiyoriy). Ishlatilmasa DB faqat "disabled" rejimda.
# driver: auto | postgres | sqlite  (auto = DSN berilgan bo'lsa postgres)
BM_DB_DRIVER=auto
# PostgreSQL ulanish qatori (PostgreSQL uchun)
# BM_DB_DSN=postgresql://user:pass@localhost:5432/bm_automation
# SQLite fayl yo'li (SQLite uchun, standart data/bm_automation.db)
# BM_DB_PATH=data/bm_automation.db
