# BM Automation - Environment Configuration
# Copy this file to .env and fill in the values

# ---- BM API ----
BM_ENV=test  # test or prod
BM_USERNAME=
BM_PASSWORD=
BM_ORGANIZATION=

# ---- Telegram Bot ----
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_DRIVER_CHAT_ID=
TG_ALLOWED_IDS=
TG_ADMIN_IDS=
TG_DISPATCHER_IDS=
TG_MANAGER_IDS=
TG_DRIVER_IDS=
TG_DEFAULT_ROLE=viewer

# ---- AI (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=BM Automation Bot

# ---- AI Schedules ----
AI_DAILY_SUMMARY=on
AI_DAILY_SUMMARY_HOUR=8
AI_SELFREVIEW=on
AI_SELFREVIEW_HOUR=9
AI_SELFREVIEW_DAYS=14

# ---- SMS Gateway (Android SMS Gateway - capcom6) ----
# Haydovchilarga kunlik SMS xabarnomalar uchun. O'z telefon+SIM karta orqali,
# Cloud Server rejimida (capcom6/adb-sms-gateway relay: https://api.sms-gate.app:443).
# Login/parol kodga emas, shu .env faylga yoziladi.
ANDROID_SMS_GATEWAY_LOGIN=
ANDROID_SMS_GATEWAY_PASSWORD=
ANDROID_SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1

# ---- Database (Primary - Local PostgreSQL) ----
BM_DB_DRIVER=postgres
BM_DB_DSN=postgresql://user:pass@localhost:5432/bm_automation

# ---- Database (Backup - Supabase) ----
# Supabase'ga zaxira nusxa yaratish uchun
# Agar ko'rsatilgan bo'lsa, backup avtomatik ishlaydi
SUPABASE_BACKUP_DSN=
# SUPABASE_BACKUP_DSN=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# ---- Backup Settings ----
BACKUP_INTERVAL_HOURS=6  # Zaxira orasidagi vaqt (soat)

# ---- Dashboard ----
DASHBOARD_PORT=8080
# Dashboard API tokeni. Bo'sh qoldirilsa autentifikatsiya O'CHIRILGAN boladi -
# internetga ochiq serverda albatta toldiring. Generatsiya:
#   python -c "import secrets; print(secrets.token_hex(24))"
DASHBOARD_TOKEN=

# ---- ATTO (dev skriptlar: tools/atto_dev/) ----
# Kaptcha/token capture skriptlari uchun. Loyiha ishlashi uchun majburiy emas.
ATTO_LOGIN=
ATTO_PASSWORD=

# ---- Rate ----
KM_RATE=0
